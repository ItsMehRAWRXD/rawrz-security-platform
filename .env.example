# RawrZ Security Platform Environment Configuration
# Copy this file to .env and configure your values

# Application Environment
NODE_ENV=production
LOG_LEVEL=info
PORT=8080

# Security Configuration
MAX_FILE_SIZE=100MB
UPLOAD_TIMEOUT=30000
ENCRYPTION_KEY_LENGTH=32

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_TO_FILE=true
LOG_RETENTION_DAYS=30

# DigitalOcean Specific (if using managed services)
# DATABASE_URL=postgresql://username:password@host:port/database
# REDIS_URL=redis://username:password@host:port

# Optional: API Keys for enhanced features
# VIRUSTOTAL_API_KEY=your_virustotal_api_key
# SHODAN_API_KEY=your_shodan_api_key

# Security Headers
SECURITY_HEADERS=true
CORS_ORIGIN=*

# File Storage (if using DigitalOcean Spaces)
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_ACCESS_KEY=your_access_key
# DO_SPACES_SECRET_KEY=your_secret_key
# DO_SPACES_BUCKET=rawrz-security-files